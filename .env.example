# Job Search 2026 — Claude CLI Environment
# Copy this file to .env and fill in your paths.
# .env is gitignored and never committed.
# Normally generated by: bash scripts/setup.sh
#
# This file is sourced by Claude Code's shell session. It intentionally
# omits storage credentials (MinIO, Postgres, Supabase, LLM API keys) so
# Claude cannot access the underlying data store directly. Those credentials
# belong in .env.services (see .env.services.example).
#
# .env.services is sourced by: scripts/start-ob1.sh, scripts/k8s-apply-env.sh

# Applicant's full name (used to name directories and pre-fill applicant.md)
export APPLICANT_NAME="First Last"

# Process repo (this repo — git-tracked)
export APP_DIR="/path/to/Job-Search-2026"

# Applicant data directory (PII, applications, profiles — NOT git-tracked)
# Generated by setup.sh based on your storage choice:
#
# Local only (default):
#   ~/Documents/job-applications
#
# Inside a cloud sync service's managed folder (auto-synced by the OS):
#   ~/Library/CloudStorage/GoogleDrive-yourname@gmail.com/My Drive/job-applications
#   ~/Library/CloudStorage/OneDrive-Personal/job-applications
#   ~/Library/Mobile Documents/com~apple~CloudDocs/job-applications
#   ~/Dropbox/job-applications
#   ~/Box/job-applications
#
export APPLICANT_DIR="/path/to/job-applications"

# Python interpreter with Playwright installed — used by scripts/fetch-jd.py
# (fetching login-walled job pages) and scripts/generate-pdf.py (resume PDF
# generation). Set once by setup.sh; always used via $PLAYWRIGHT_PYTHON.
#
# Setup (once per machine):
#   pip install playwright && playwright install chromium
#   Then set this to whichever python has playwright:
#     python3 -c "import playwright" && echo "this python works"
#
# Per-site auth (once per site):
#   python3 scripts/fetch-jd.py --setup 'https://www.linkedin.com/jobs/view/123'
#   → opens a browser → you log in → press Enter → auth saved to .auth/
#
export PLAYWRIGHT_PYTHON="python3"

# Deno binary — not on the system PATH by default (installed to ~/.deno/bin/).
# Always invoke via $DENO_BIN rather than bare 'deno'. Used for unit tests in
# integrations/ob1/tests/*.ts. Run 'curl -fsSL https://deno.land/install.sh | sh'
# to install, then set this to the output path (typically $HOME/.deno/bin/deno).
export DENO_BIN="$HOME/.deno/bin/deno"

# Developer mode — controls whether Claude can edit files in $APP_DIR.
#
# false (default): $APP_DIR is read-only. Claude can only write to $APPLICANT_DIR.
# true:            Both $APP_DIR and $APPLICANT_DIR are writable.
#                  Use only when intentionally modifying the process/tooling repo.
#
# Toggle: edit .env and change "false" to "true" (no restart needed — hook re-reads .env per call)
#
export DEV_MODE="false"

# SearchAPI key — used by scripts/search-jobs.py for /ingest command
# Get your key at https://www.searchapi.io/
#
export SEARCHAPI_KEY="your_searchapi_key_here"

# /ingest tuning
# SEARCH_TARGET_FITS — target number of fit job stubs to create per /ingest run (default: 10)
# SEARCH_BATCH_SIZE  — jobs per API page / Haiku screening batch (default: 10)
#
export SEARCH_TARGET_FITS="10"
export SEARCH_BATCH_SIZE="10"

# Anthropic API key — only needed if NOT using Claude Code OAuth
#
# If you have logged in via 'claude auth login' (desktop app, VS Code, JetBrains,
# or 'claude auth login' in the terminal), leave this commented out.
#
# If you are using the Claude CLI in terminal-only mode without OAuth, set this.
# setup.sh detects OAuth status automatically and only prompts if needed.
# Get your key at https://console.anthropic.com/
#
# export ANTHROPIC_API_KEY="sk-ant-..."

# ---------------------------------------------------------------------------
# LinkedIn real-Chrome scraping (optional — avoids bot-detection throttling)
# ---------------------------------------------------------------------------
#
# Set CHROME_PROFILE to use your actual Chrome session instead of saved cookies.
# With this set, /linkedin-ingest drives your real Chrome browser — LinkedIn sees
# normal traffic and returns full page yields (~25 cards/page vs ~1-2 headless).
#
# CHROME_PROFILE: path to the Chrome profile dir where you are logged into LinkedIn.
#   Find your exact path: open chrome://version/ in Chrome → look at "Profile Path".
#   Common paths on macOS:
#     Default profile:  $HOME/Library/Application Support/Google/Chrome/Default
#     Named profile:    $HOME/Library/Application Support/Google/Chrome/Profile 1
#
# LINKEDIN_CDP_PORT: set this if you want to reuse an already-running Chrome window.
#   Launch Chrome with: bash scripts/launch-chrome-debug.sh
#   Then /linkedin-ingest connects to it instead of launching a new Chrome window.
#   Optional — leave commented out to use profile-launch mode (Chrome appears briefly).
#
# One-time setup: log into LinkedIn in the Chrome profile pointed to by CHROME_PROFILE.
# After that, no --setup dance, no cookie export — sessions persist in the profile.
#
# export CHROME_PROFILE="$HOME/Library/Application Support/Google/Chrome/Default"
# export LINKEDIN_CDP_PORT="9222"

# ---------------------------------------------------------------------------
# Auth — Playwright session files
# ---------------------------------------------------------------------------
#
# AUTH_DIR: directory where Playwright auth files are stored (<domain>.json).
# Defaults to $APP_DIR/.auth/ when not set. Already in .gitignore.
# Applies to all login-walled sites: LinkedIn and any other domain set up via
# fetch-jd.py --setup or --import.
#
# LOCAL / OB1-LOCAL: leave unset. Files go to $APP_DIR/.auth/ automatically.
#
# K8S DEPLOYMENT: set to the mounted secret path.
#   export AUTH_DIR="/mnt/secrets/linkedin-auth"
#
# DOCKER COMPOSE: set to the mounted volume path.
#   export AUTH_DIR="/mnt/auth"
#
# MIGRATION: if you previously set up auth with APPLICANT_DIR configured,
# your auth files are at $APPLICANT_DIR/.auth/<domain>.json. Copy them once:
#   cp "$APPLICANT_DIR/.auth/"*.json "$APP_DIR/.auth/"
#
# Updating auth in container environments (LinkedIn only — most ATS are public):
#   1. Refresh locally via Firefox import or Chrome debug mode (see DEVELOPER-README.md)
#   2. K8s:  kubectl create secret generic linkedin-auth \
#                --from-file=linkedin.com.json="$APP_DIR/.auth/linkedin.com.json" \
#                --dry-run=client -o yaml | kubectl apply -f -
#   3. Docker Compose: copy updated file to the bind-mount path; restart service if needed.
#
# export AUTH_DIR="$APP_DIR/.auth"

# ---------------------------------------------------------------------------
# Webapp — Claude Code binary used by the web app's chat sessions
# ---------------------------------------------------------------------------

# Claude Code binary used by the webapp for chat subprocess sessions.
#
# LOCAL DEPLOYMENTS (no CLAUDE_RUNNER_URL): leave this unset.
# The webapp auto-discovers the latest installed VS Code extension binary by
# globbing ~/.vscode/extensions/anthropic.claude-code-*/resources/native-binary/claude
# and picking the highest semver. Falls back to system PATH 'claude' if no
# VS Code extension is found. No manual update needed when VS Code auto-updates.
#
# CONTAINER / K8S DEPLOYMENTS (CLAUDE_RUNNER_URL is set): set this to the
# binary path as it exists inside the runner container. The k8s configmap
# already sets CLAUDE_BINARY=/usr/local/bin/claude — no change needed there.
#
# Set this only to pin a specific version for testing, or in container mode
# when the runner binary is at a non-default path.
#
# export CLAUDE_BINARY="/usr/local/bin/claude"

# ---------------------------------------------------------------------------
# OB1 Integration — fill in after K8s cluster is running
# See integrations/ob1/README.md for setup instructions.
# ---------------------------------------------------------------------------

# Data backend selector — controls BOTH the webapp and Claude Code terminal sessions.
#
# 'local' (default): All applicant data is read/written from APPLICANT_DIR on disk.
#                    No OB1 services required. Webapp and terminal both use local files.
#
# 'ob1':             All applicant data goes through the job-search MCP server.
#                    This is the ONLY MCP server — it contains all OB1 tools (thoughts,
#                    search, knowledge graph) plus job-search tools. No separate
#                    open-brain server is needed. Webapp routes all reads and writes
#                    through the job-search-mcp REST API (/api/v2/* and /ob1/rest/*).
#                    Requires OB1 services running and .mcp.json registered.
#
export DATA_BACKEND="local"

# Job Search MCP service — the single MCP server for all job-search + OB1 tools.
# Routed via nginx Ingress at /job-search (no port-forward needed when Ingress is up).
# OB1-compat tools (search, fetch, thought_stats) and REST routes (/ob1/rest/*) are
# served by this same server — no separate open-brain MCP server required.
export JOB_SEARCH_MCP_URL="http://localhost/job-search"
export JOB_SEARCH_MCP_KEY="your_job_search_mcp_access_key"

# Job Search REST API — used by the webapp to route all data access through job-search-mcp.
# Local dev: port-forward svc/job-search-mcp to 8001, then use http://localhost:8001
# Docker compose (OB1 mode): set to http://job-search-mcp:8001 (service name)
# K8s: set automatically from webapp-configmap.yml; override here only for local dev.
export JOB_SEARCH_REST_URL="http://localhost/job-search"

# Skill runtime (webapp /api/skills endpoints)
# RUNTIME_ADAPTER: claude-runner (default) | hermes (experimental)
# RUNTIME_ALLOW_DRAFT: true allows running draft skill versions via the API (dev only)
export RUNTIME_ADAPTER="claude-runner"
export RUNTIME_ALLOW_DRAFT="false"

# Hermes adapter (experimental — RUNTIME_ADAPTER=hermes)
# Hermes Agent has no documented headless mode; set HERMES_HEADLESS_CMD to a
# verified command template ({skill} placeholder) to enable execution.
# export HERMES_HOME="$HOME/.hermes"
# export HERMES_HEADLESS_CMD=""
